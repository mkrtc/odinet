{
  "manifest_version": 3,
  "name": "Odinet",
  "description": "Локальный журнал HTTP-запросов для исследования сайтов.",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "permissions": ["webRequest", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Odinet",
    "default_popup": "popup.html"
  }
}
